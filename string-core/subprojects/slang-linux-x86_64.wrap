# Slang shader compiler — consumed as a prebuilt shared library (Slang ships no static libs). The
# compiler runs in-process for shader hot-reload; libslang is linked dynamically and shipped
# alongside the binary.
#
# A meson wrap-file pins exactly ONE archive and Slang's prebuilt differs per OS, so there is one
# wrap per platform (see slang-windows-x86_64.wrap) and string-core/meson.build picks between them
# with an explicit subproject() call on host_machine.system(). Hence no [provide] section here: two
# wraps both providing `slang` would be a duplicate-provider conflict.
[wrap-file]
directory = slang-2026.12.0.1-linux-x86_64
source_url = https://github.com/shader-slang/slang/releases/download/v2026.12.0.1/slang-2026.12.0.1-linux-x86_64.tar.gz
source_filename = slang-2026.12.0.1-linux-x86_64.tar.gz
source_hash = bbd36968b5aefdf91c2ede0d2e131f8b552cba6ed2444da59f1a0bc0bfc6792d
# The archive has no top-level wrapper dir (bin/ lib/ include/ sit at its root), so tell
# meson to extract into `directory` rather than scattering them across subprojects/.
lead_directory_missing = true
patch_directory = slang
