#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require

// GPU draw-list generation with frustum culling. One thread per draw: test the draw's world-space
// AABB against the camera frustum (extracted from view_proj), and write this draw's indirect
// command at its fixed slot with instanceCount = 1 (visible) or 0 (culled -> the GPU skips it for
// free). Fixed slots keep the draw order deterministic (no order-dependent z-fighting) and avoid
// an atomic counter. Buffers are reached by device address (push constant), not descriptors.

struct CullDraw {
    vec4 aabb_min;      // world-space AABB (xyz; w unused)
    vec4 aabb_max;
    uint index_count;
    uint first_index;
    uint vertex_offset;
    uint draw_id;       // -> firstInstance, so the vertex shader indexes DrawData[draw_id]
};

struct IndirectCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
};

layout(buffer_reference, scalar) readonly buffer CullDrawRef { CullDraw draws[]; };
layout(buffer_reference, scalar) buffer IndirectRef { IndirectCommand cmds[]; };

layout(push_constant) uniform Push {
    mat4         view_proj;
    CullDrawRef  cull_in;
    IndirectRef  indirect_out;
    uint         draw_count;
    uint         cull_enabled;   // 0 = emit every draw (debug), 1 = frustum cull
} pc;

layout(local_size_x = 64) in;

// AABB fully outside the frustum? Extract the 6 inward-pointing planes (Gribb-Hartmann) from the
// view-projection and, for each, test the AABB's positive vertex; if it's outside any one plane
// the whole box is outside. Conservative (never culls a visible draw).
bool aabb_outside_frustum(vec3 mn, vec3 mx) {
    // Rows of the (column-major) matrix.
    vec4 r0 = vec4(pc.view_proj[0][0], pc.view_proj[1][0], pc.view_proj[2][0], pc.view_proj[3][0]);
    vec4 r1 = vec4(pc.view_proj[0][1], pc.view_proj[1][1], pc.view_proj[2][1], pc.view_proj[3][1]);
    vec4 r2 = vec4(pc.view_proj[0][2], pc.view_proj[1][2], pc.view_proj[2][2], pc.view_proj[3][2]);
    vec4 r3 = vec4(pc.view_proj[0][3], pc.view_proj[1][3], pc.view_proj[2][3], pc.view_proj[3][3]);

    vec4 planes[6];
    planes[0] = r3 + r0;   // left
    planes[1] = r3 - r0;   // right
    planes[2] = r3 + r1;   // bottom
    planes[3] = r3 - r1;   // top
    planes[4] = r2;        // near (z >= 0 for a ZERO_TO_ONE clip volume)
    planes[5] = r3 - r2;   // far

    for (int i = 0; i < 6; ++i) {
        vec3 n = planes[i].xyz;
        // Positive vertex: the AABB corner furthest along the plane normal.
        vec3 p = vec3(n.x >= 0.0 ? mx.x : mn.x,
                      n.y >= 0.0 ? mx.y : mn.y,
                      n.z >= 0.0 ? mx.z : mn.z);
        if (dot(n, p) + planes[i].w < 0.0) {
            return true;   // entirely on the outside of this plane
        }
    }
    return false;
}

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.draw_count) {
        return;
    }

    CullDraw d = pc.cull_in.draws[i];
    const bool visible = (pc.cull_enabled == 0u)
        || !aabb_outside_frustum(d.aabb_min.xyz, d.aabb_max.xyz);

    // Fixed slot == draw index: deterministic order; culled draws get instanceCount 0.
    pc.indirect_out.cmds[i] = IndirectCommand(
        d.index_count, visible ? 1u : 0u, d.first_index, int(d.vertex_offset), d.draw_id);
}
