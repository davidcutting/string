[wrap-file]
directory = meshoptimizer-1.1.1
source_url = https://github.com/zeux/meshoptimizer/archive/refs/tags/v1.1.1.tar.gz
source_filename = meshoptimizer-1.1.1.tar.gz
source_hash = 30cd4d28fe71bf58c614c23c87fed385bac223acbb2dfaf343d20ffc3584a083
# Meshlet build (meshopt_buildMeshlets) + the LOD simplify chain (brief 03). Built via Meson's CMake
# integration (upstream is CMake-only), exposing the `meshoptimizer` CMake target.
#
# Tracked here, beside ktx.wrap, because only a library's OWN subprojects/ dir is in git —
# sandbox/subprojects/ is gitignored except the sibling-library symlinks, so a wrap left there is
# local cruft that no clean clone ever sees. This file existed only as that cruft until 2026-08-04,
# which meant off-nix builds had no meshoptimizer at all; nix hid it by supplying one from nixpkgs.
#
# THIS VERSION MUST TRACK NIXPKGS. Only the off-nix build resolves this wrap — on nix the dependency
# comes from nixpkgs — so a stale wrap means the artist ships a different simplifier from the one we
# test against, silently. It was pinned at 0.21 against nixpkgs 1.1.1 until 2026-08-08, four minor
# versions of simplifier fixes apart. bake.cpp static_asserts MESHOPTIMIZER_VERSION so the next
# divergence is a compile error naming both numbers instead of a behavioural difference nobody sees.
#
# The hash is of the GitHub auto-generated tag archive. Those are not byte-stable across
# regenerations, so if the download ever fails its integrity check, re-fetch and update it here
# rather than assuming the file was tampered with.
method = cmake

[provide]
meshoptimizer = meshoptimizer_dep
