# Slang shader compiler — consumed as a prebuilt shared library (Slang ships no static
# libs). The compiler runs in-process for shader hot-reload; libslang is linked dynamically
# and shipped alongside the binary.
#
# NOTE: meson wrap-file pins a single archive, and Slang's prebuilt differs per OS. This wrap
# targets linux-x86_64; for a Windows build swap source_url/source_filename/source_hash to the
# matching slang-<ver>-windows-x86_64.zip release asset (the patch_directory build is
# platform-generic and picks up bin/lib/include either way).
[wrap-file]
directory = slang-2026.12.0.1
source_url = https://github.com/shader-slang/slang/releases/download/v2026.12.0.1/slang-2026.12.0.1-linux-x86_64.tar.gz
source_filename = slang-2026.12.0.1-linux-x86_64.tar.gz
source_hash = bbd36968b5aefdf91c2ede0d2e131f8b552cba6ed2444da59f1a0bc0bfc6792d
# The archive has no top-level wrapper dir (bin/ lib/ include/ sit at its root), so tell
# meson to extract into `directory` rather than scattering them across subprojects/.
lead_directory_missing = true
patch_directory = slang

[provide]
slang = slang_dep
